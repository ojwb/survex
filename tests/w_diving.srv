; Test diving data handling
#units m
#units save
#UNITS ORDER=DA Tape=SS
;From To Dist Az From-Depth To-Depth
3.0	X:1	0	0	0	;?
1.0	2.0	3	220	10.5	9
2.0	3.0	1.5	135	11	8.5 ; a comment
#units restore
1.0 4 1.0 - -90
#units tape=ss order=da
;From To Dist Az From-Depth To-Depth
3.1	X:1	0	0	0	;?
1.1	2.1	3	220	10.5	9
2.1	3.1	1.5	135	11	8.5 ; a comment

; Test ORDER including V but with clinos omitted.
#units save
#UNITS ORDER=DAV Tape=SS
;From   To      Dist    Az   Gradient FrDepth ToDepth
V:3.0   X:1     0       0    --/--      0             ;?
V:1.0   V:2.0   3       220  -- 10.5    9
V:2.0   V:3.0   1.5     135  --/--      11      8.5   ; a comment
V:1.0   V:4     1.0     -    -90                      ; plub leg
#units restore
#units tape=ss order=vda
;From   To   Gradient Dist Az   FrDepth ToDepth
V:3.1   X:1     --    0    0       0             ;?
V:1.1   V:clino +30   3    000                   ; clino leg
V:1.1   V:2.1   --    3    220     10.5    9
V:1.1   V:plumb -90   3    --      --      --    ; plumb leg
V:2.1   V:3.1   --    1.5  135     11      8.5   ; a comment
