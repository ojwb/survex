; Test cases where readings trigger warnings or errors.
a b 10.0 f 005d +10
a c 10.0f 365d +10		; Walls: "Bearing out of range" error
a d 10.0d 005d -10
a e 10.0 005d N10E
a f 10.0i6 N10E 81
a g 10i6 N-10W 81
a h 10i6 N10E 91		; Walls: "Inclination out of range" error
a i 10.0  30.5:20 -11g
a j 10.0  30:50 -101g		; Walls: "Inclination out of range" error
a k 1.0 -1 +10			; Walls: "Bearing can't have sign" error
a l -10.0  30:20 -11g		; Walls: "Distance can't have sign" error
a m 10.0 12.5:0 0:0
a n 10.0 12:0 0.5:0
a o 10.0 12:29.5:30 0d
a p 10.0 12:0 0:1.5:1
a q i12   12:30 0
a r i11.5 12:30: 0
a s i11.9 12:30 0:
a t i11.9 12:30:. 0:0.
