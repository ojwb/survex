; pos=no warn=0
; test that we can at least specify a title
*title cave
*begin survey
*title "multi word title"
*fix 1 0 0 0
1 2 1 0 0
*end survey

*begin survey2
; empty title
*title ""
*fix a 0 0 0
a b 1 0 0
*end survey2

*begin survey3
*title used; to eat comments
*fix z 0 0 0
z x 1 0 0
*end survey3

*begin survey4
*title "title with escaped "" in it"
*fix z 0 0 0
z x 1 0 0
*end survey4

*begin survey5
*title "title ending with escaped """
*fix z 0 0 0
z x 1 0 0
*end survey5

*begin survey6
*title """ at start"
*fix z 0 0 0
z x 1 0 0
*end survey6
